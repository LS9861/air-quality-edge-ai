# ---- PlatformIO / firmware build artifacts ----
firmware/.pio/
firmware/.pioenvs/
firmware/.piolibdeps/
*.bin
*.elf
*.map
*.o
*.d

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# ---- Data (keep folder structure via .gitkeep, ignore recorded data) ----
data/raw/**/*.csv
data/raw/**/*.json
data/processed/*
!data/processed/.gitkeep
# Synthetic test data generated by make_dummy_data.py
data/dummy/
data/dummy*/

# ---- ML artifacts (models may be large / regenerable) ----
ml/artifacts/
ml/**/*.joblib
ml/**/*.pkl
ml/**/*.h5
ml/**/*.tflite
firmware/models/*
!firmware/models/.gitkeep

# ---- Firmware secrets (WiFi creds, API keys) ----
firmware/include/secrets.h

# ---- Editor / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
